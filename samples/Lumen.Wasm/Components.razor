@page "/components"
<PageTitle>Beyond charts — Lumen on WebAssembly</PageTitle>
<div class="app comp @(dark ? "dark" : "")">
    <main>
        <nav class="pages" aria-label="Pages"><a href="/">Charts</a> <a href="components" aria-current="page">Beyond charts</a></nav>
        <div class="topbar"><span class="version">Invented data</span><button @onclick="ToggleTheme" aria-label="Toggle color theme">@(dark ? "☀ Light mode" : "☾ Dark mode")</button></div>
        <section class="intro">
            <div class="eyebrow"><span></span> STAT TILES</div>
            <h1>Headline numbers. <em>Said in words.</em></h1>
            <p>Not every number wants an axis. <code>LumenStats</code> writes a label, a value and its change as plain HTML: the arrow, the colour and the meter are each said in words as well, so nothing rests on colour alone. Here it runs entirely in the browser, on WebAssembly.</p>
            <div class="segmented" role="group" aria-label="Chart brand">
                @foreach (var (choice, name) in Brands)
                { <button class="@(brand == choice ? "selected" : "")" aria-pressed="@(brand == choice ? "true" : "false")" @onclick="() => SetBrand(choice)">@name</button> }
            </div>
        </section>
        <section id="season">
            <div class="chart-card comp-card">@Branded(@<LumenStats Spec="DemoData.SeasonTiles(Style)"/>)</div>
        </section>
        <section id="rounds">
            <div class="chart-card comp-card">@Branded(@<LumenStats Spec="DemoData.RoundStrip(Style)"/>)</div>
        </section>
        <section class="intro">
            <div class="eyebrow"><span></span> DATA TABLE</div>
            <h2>Rows to read. <em>Columns to sort.</em></h2>
            <p><code>LumenTable</code> writes a real HTML table: press a header to sort, page through long lists, and scroll sideways on a phone while the header row and the first column stay in view. Every arrow, bar and trend line is also written in words, and <code>ShowExport</code> adds a CSV of the rows.</p>
        </section>
        <section id="results">
            <div class="chart-card comp-card comp-results">@Branded(@<LumenTable Spec="DemoData.ResultsTable(Style)" ShowExport="true"/>)</div>
        </section>
        <section id="log">
            <div class="chart-card comp-card">@Branded(@<LumenTable Spec="DemoData.TrainingLog(Style)"/>)</div>
        </section>
        <section class="intro">
            <div class="eyebrow"><span></span> EVENT TIMELINE</div>
            <h2>What happened. <em>What is next.</em></h2>
            <p><code>LumenEvents</code> writes dated events as a vertical list under month headings, with a Now marker between what is done and what is to come. Each status is a word as well as a mark. With <code>PageSize</code> it opens on the events nearest Now, and Show earlier and Show later buttons reveal the rest.</p>
        </section>
        <section id="timeline">
            <div class="chart-card comp-card">@Branded(@<LumenEvents Spec="DemoData.RiderSeason(Style)" PageSize="6"/>)</div>
        </section>
    </main>
</div>
@code {
    private static readonly (Lumen.Gallery.BrandDemo Brand, string Name)[] Brands =
        [(Lumen.Gallery.BrandDemo.Lumen, "Lumen brand"), (Lumen.Gallery.BrandDemo.Harbour, "Harbour (C#)"), (Lumen.Gallery.BrandDemo.PageCss, "Page CSS"), (Lumen.Gallery.BrandDemo.Midnight, "Midnight")];
    private bool dark;
    private Lumen.Gallery.BrandDemo brand;
    // The Lumen brand cascades no style, so the tiles ask for the theme's own, which is the card's colour; the other brands cascade theirs.
    private ChartStyle? Style => brand == Lumen.Gallery.BrandDemo.Lumen ? (dark ? ChartStyle.Dark : ChartStyle.Light) : null;
    private RenderFragment Branded(RenderFragment content) => brand switch
    {
        Lumen.Gallery.BrandDemo.Midnight => @<CascadingValue Value="ChartStyle.Midnight">@content</CascadingValue>,
        Lumen.Gallery.BrandDemo.PageCss => @<LumenBrand Series="--brand-1, --brand-2, --brand-3, --brand-4" Background="--surface" Text="--text" Muted="--muted" Grid="--line">@content</LumenBrand>,
        Lumen.Gallery.BrandDemo.Harbour => @<CascadingValue Value="Lumen.Gallery.DemoData.Harbour">@content</CascadingValue>,
        _ => content
    };
    private void ToggleTheme() => dark = !dark;
    private void SetBrand(Lumen.Gallery.BrandDemo choice) => brand = choice;
}
