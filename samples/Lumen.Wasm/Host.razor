<main>
<LumenBrand Series="--brand-1, --brand-2, --brand-3" Background="--surface" Text="--ink" Muted="--ink-muted" Grid="--rule">
    <h1>Lumen Charts on WebAssembly</h1>
    <p>The same components as the server gallery, running entirely in the browser. Every chart below is rendered by <code>Lumen.Charts</code> inside WebAssembly, with tooltips, exports, point selection and node dragging supplied by the shared static assets of the Razor class library.</p>

    <h2 id="charts">Chart families</h2>
    <div class="kinds" role="group" aria-labelledby="charts">
        @foreach(var kind in kinds)
        {
            var choice=kind;
            <button type="button" aria-pressed="@(selected==kind ? "true" : "false")" @onclick="()=>Select(choice)">@kind</button>
        }
    </div>
    <div class="card"><LumenChart @key="selected" Spec="Current" PointSelected="OnPoint" FitWidth="true"/></div>
    <p class="state" role="status">@(point ?? "Select a mark to report its original series and point index.")</p>

    <h2 id="graph">Network</h2>
    <div class="card"><LumenGraph Spec="graph" NodeSelected="OnNode"/></div>
    <p class="state" role="status">@(node ?? "Drag a node, or focus one and press Enter to select it.")</p>

    <h2 id="form">Every series at once</h2>
    <div class="card"><LumenChart Spec="form" FitWidth="true"/></div>

    <h2 id="gaps">Lines named at their ends</h2>
    <div class="card"><LumenChart Spec="gaps" FitWidth="true" ShowLegend="false" ShowToolbar="false"/></div>

    <h2 id="strip">Parts of a whole</h2>
    <div class="card"><LumenChart Spec="strip" FitWidth="true"/></div>
</LumenBrand>
</main>
@code {
    private static readonly ChartKind[] kinds=[ChartKind.Line,ChartKind.Column,ChartKind.Candlestick,ChartKind.Histogram,ChartKind.Box,ChartKind.Donut];
    private ChartKind selected=ChartKind.Line;
    private string? point,node;
    private void Select(ChartKind kind){selected=kind;point=null;}
    private void OnPoint(PointSelection selection)=>point=$"Selected series {selection.SeriesIndex+1}, observation {selection.PointIndex+1}";
    private void OnNode(string id)=>node=$"Selected node \"{id}\"";

    private static readonly string[] months=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    private static readonly Random random=new(7);
    private static readonly double[] samples=Enumerable.Range(0,180).Select(_=>Math.Round(40-Math.Log(1-random.NextDouble())*22,1)).ToArray();

    private ChartSpec Current=>selected switch
    {
        ChartKind.Candlestick=>new(){Kind=selected,Title="Simulated prices",Description="Thirty daily candles on a UTC time axis",XAxis=AxisKind.Time,
            XLabel="Trading day (UTC)",YLabel="Price",Series=[new("ACME",Candles())],Source="Source: generated sample data"},
        ChartKind.Histogram=>new(){Kind=selected,Title="Response times",Description="180 sampled requests, bin count chosen from the data",
            XLabel="Response time (ms)",YLabel="Requests",Series=[new("Latency",samples.Select(ChartPoint.Observation).ToArray())],Source="Source: generated sample data"},
        ChartKind.Box=>new(){Kind=selected,Title="Latency by region",Description="Quartiles, Tukey whiskers and outliers",YLabel="Latency (ms)",
            Series=[new("Europe",samples.Take(60).Select(ChartPoint.Observation).ToArray()),
                    new("Africa",samples.Skip(60).Take(60).Select(v=>ChartPoint.Observation(v*1.3)).ToArray()),
                    new("Americas",samples.Skip(120).Select(v=>ChartPoint.Observation(v*.8)).ToArray())],Source="Source: generated sample data"},
        ChartKind.Donut=>new(){Kind=selected,Title="Acquisition mix",Description="Share of 100 sample accounts",
            Series=[new("Acquisition",[new(0,42,"Organic"),new(1,28,"Direct"),new(2,18,"Referral"),new(3,12,"Campaigns")])],Source="Source: generated sample data"},
        // One plan misses a month, which its line breaks for and the arrow keys step over.
        _=>new(){Kind=selected,Title="Monthly activity",Description="Three product plans across one year",XLabel="Month",YLabel="Active accounts (thousands)",
            Series=[Plan("Workspace",34),Plan("Enterprise",21),selected==ChartKind.Line?Missing(Plan("Community",11),6):Plan("Community",11)],Source="Source: generated sample data"}
    };

    // Eight invented weeks of training: fitness and fatigue over each day's stress, and form beneath on an axis held symmetric about zero
    // and written with its sign. The shared readout reads all four at the day under the pointer or the focused point.
    private static readonly ChartSpec form=Form();
    private static ChartSpec Form()
    {
        var start=new DateOnly(2026,6,1);
        var load=Training.Load(Enumerable.Range(0,56).Select(i=>(start.AddDays(i),(double)((i%7) switch{0=>0,2=>120,5=>150,_=>60}))),40,40);
        double When(DateOnly day)=>TimeAxis.Value(new DateTimeOffset(day.ToDateTime(TimeOnly.MinValue),TimeSpan.Zero));
        return new(){Kind=ChartKind.Line,XAxis=AxisKind.Time,Height=460,SharedReadout=true,Title="Fitness and form",Description="Eight invented weeks · fitness, fatigue and stress above, form below",
            YLabel="Training stress",Panes=[new(){Label="Form",Weight=.6,YSymmetric=10,YFormat=ValueFormat.Signed}],Source="Source: generated sample data",
            Series=[ChartSeries.From("Fitness",load,d=>When(d.Day),d=>Math.Round(d.Fitness,1)),ChartSeries.From("Fatigue",load,d=>When(d.Day),d=>Math.Round(d.Fatigue,1)),
                ChartSeries.From("Form",load,d=>When(d.Day),d=>Math.Round(d.Form,1)) with{Pane=1},
                ChartSeries.From("Stress",load,d=>When(d.Day),d=>d.Stress) with{Kind=ChartKind.Column,Color="#848484"}]};
    }

    // An invented race of five riders over five laps: each rider's seconds behind whoever led at each lap, the leader at the top, every line
    // named at its end, so the chart needs no legend, and drawn as a phone card would be, without its toolbar.
    private static readonly ChartSpec gaps=Gaps();
    private static ChartSpec Gaps()
    {
        double[][] laps=[[301,296,299,298,297],[298,300,303,295,300],[305,301,298,304,299],[303,306,309,302,306],[308,302,297,296,292]];
        var clocks=laps.Select(rider=>rider.Aggregate(new List<double>{0},(clock,lap)=>{clock.Add(clock[^1]+lap);return clock;}).ToArray()).ToArray();
        var behind=clocks.Select(clock=>clock.Select((t,lap)=>t-clocks.Min(other=>other[lap])).ToArray()).ToArray();
        var words=new Axis(AxisKind.Linear,0,1){ValueFormat=ValueFormat.Signed,Unit="s"};
        string[] names=["Rider A","Rider B","Rider C","Rider D","You"];
        return new(){Kind=ChartKind.Line,Height=360,SharedReadout=true,YReversed=true,YMin=0,YFormat=ValueFormat.Signed,YUnit="s",XLabel="Lap",
            Title="Gap to the leader",Description="An invented race · seconds behind the leader at each lap",Source="Source: generated sample data",
            Series=names.Select((name,r)=>new ChartSeries(name,behind[r].Select((g,lap)=>new ChartPoint(lap,g,lap==0?"Start":$"Lap {lap}")).ToArray(),r==4?null:"#848484")
                {StrokeWidth=r==4?3.2:2,Markers=MarkerStyle.None,EndLabel=r==4?"You":name[^1..],EndNote=behind[r][^1]==0?"leader":words.Format(behind[r][^1])}).ToArray()};
    }

    // An invented ride's time in three heart-rate zones as one strip of shares, each zone in a brand colour, its percentage in the key under it.
    private static readonly ChartSpec strip=new(){Kind=ChartKind.Strip,YFormat=ValueFormat.Duration,Title="Effort zones",Description="An invented ride · time in each heart-rate zone",
        Source="Source: generated sample data",Series=[new("Time in zone",[new(0,2280,"Easy"),new(1,1420,"Moderate"),new(2,510,"Hard")])]};

    private static ChartSeries Missing(ChartSeries series,int month)=>series with{Points=series.Points.Select((p,i)=>i==month?p with{Y=null}:p).ToArray()};

    private static ChartSeries Plan(string name,double baseline)=>
        new(name,Enumerable.Range(0,12).Select(i=>new ChartPoint(i,Math.Round(baseline+i*1.8+Math.Sin(i+baseline)*6,1),months[i])).ToArray());

    private static ChartPoint[] Candles()
    {
        var day=new DateTimeOffset(2026,3,2,0,0,0,TimeSpan.Zero);var open=118.0;var candles=new List<ChartPoint>();
        var walk=new Random(11);
        for(var i=0;i<30;i++)
        {
            var close=Math.Round(open*(1+(walk.NextDouble()-.47)*.06),2);
            candles.Add(ChartPoint.Candle(TimeAxis.Value(day.AddDays(i)),open,
                Math.Round(Math.Max(open,close)*(1+walk.NextDouble()*.018),2),
                Math.Round(Math.Min(open,close)*(1-walk.NextDouble()*.018),2),close));
            open=close;
        }
        return candles.ToArray();
    }

    private readonly GraphSpec graph=new()
    {
        Title="From source to insight",
        Nodes=[new("sources","Sources"),new("ingest","Ingestion"),new("validate","Validation"),new("transform","Transform"),
               new("charts","Charts"),new("api","Chart API"),new("reports","Reports")],
        Edges=[new("sources","ingest"),new("ingest","validate"),new("validate","transform"),new("transform","charts"),
               new("transform","api"),new("charts","reports"),new("api","reports"),new("ingest","reports","audit trail")]
    };
}
