@page "/"
@inject GalleryLook Look
<PageTitle>Lumen — Charts & Graphs for .NET</PageTitle>
<div class="app @(dark ? "dark" : "")">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-icon">◒</span> lumen<span class="brand-dot">.</span></a>
        <div class="workspace">VISUALIZATION LIBRARY <span>0.1</span></div>
        <a class="nav-item active" href="#playground"><span>▦</span> Chart explorer <b>23</b></a>
        <a class="nav-item" href="#network"><span>⌘</span> Network graphs <b>2</b></a>
        <a class="nav-item" href="#integration"><span>⌁</span> Developer API</a>
        <a class="nav-item" href="sports"><span>∿</span> Sports &amp; performance <b>31</b></a>
        <div class="nav-label">EXPLORE BY PURPOSE</div>
        @foreach(var item in new[]{("Change over time",ChartKind.Line),("Compare categories",ChartKind.Bar),("Find relationships",ChartKind.Scatter),("Parts of a whole",ChartKind.Donut),("Patterns & density",ChartKind.Heatmap)})
        { <button class="purpose" @onclick="()=>Select(item.Item2)">@item.Item1<span>↗</span></button> }
        <div class="sidebar-bottom"><span class="live-dot"></span> Built for Blazor<p>Clear data. Thoughtful defaults.</p><a href="#integration">Start building →</a></div>
    </aside>
    <main>
        <header class="topbar"><div>Library <span>/</span> <strong>Chart explorer</strong></div><div class="top-actions"><span class="version">.NET 8+ compatible</span><button @onclick="ToggleTheme" aria-label="Toggle color theme">@(dark ? "☀ Light mode" : "☾ Dark mode")</button></div></header>
        <section class="intro"><div class="eyebrow"><span></span> A NEW PERSPECTIVE ON YOUR DATA</div><h1>Make the numbers<br/><em>mean something.</em></h1><p>A native .NET charting toolkit for clear comparisons, meaningful<br class="desktop"/> relationships, and the stories hiding in your data.</p><a class="primary-link" href="#integration">Build your first chart <span>↗</span></a><a class="secondary-link" href="#network">Explore graph layouts →</a><a class="secondary-link" href="sports">Sports &amp; performance →</a><div class="intro-art" aria-hidden="true"><div class="art-grid"></div><svg viewBox="0 0 330 155"><path d="M0 140 L45 112 L85 122 L130 66 L172 87 L220 28 L263 42 L315 5" fill="none" stroke="#5675e7" stroke-width="3"/><path d="M0 148 L45 132 L85 135 L130 105 L172 112 L220 75 L263 84 L315 48" fill="none" stroke="#69bbaa" stroke-width="2" stroke-dasharray="5 5"/></svg><span>LESS NOISE. MORE SIGNAL.</span></div></section>
        <div class="feature-strip"><div><b>23</b><span>Chart types</span></div><div><b>02</b><span>Graph layouts</span></div><div><b>SVG</b><span>Resolution independent</span></div><div><b>C#</b><span>From data to display</span></div></div>
        <section id="playground" class="explorer">
            <div class="section-heading"><div><div class="eyebrow">THE PLAYGROUND</div><h2>Your data, a different angle.</h2></div><span class="quiet">Choose a chart. Explore the possibilities.</span></div>
            <div class="chart-tabs" role="group" aria-label="Chart type">
                @foreach(var kind in Enum.GetValues<ChartKind>())
                { <button class="@(selected==kind ? "selected" : "")" aria-pressed="@(selected==kind ? "true" : "false")" @onclick="()=>Select(kind)">@Name(kind)</button> }
            </div>
            <div class="segmented axis-choice" role="group" aria-label="Chart brand">
                <button class="@(brand==BrandDemo.Lumen ? "selected" : "")" aria-pressed="@(brand==BrandDemo.Lumen ? "true" : "false")" @onclick="()=>brand=BrandDemo.Lumen">Lumen brand</button>
                <button class="@(brand==BrandDemo.Harbour ? "selected" : "")" aria-pressed="@(brand==BrandDemo.Harbour ? "true" : "false")" @onclick="()=>brand=BrandDemo.Harbour">Harbour (C#)</button>
                <button class="@(brand==BrandDemo.PageCss ? "selected" : "")" aria-pressed="@(brand==BrandDemo.PageCss ? "true" : "false")" @onclick="()=>brand=BrandDemo.PageCss">Page CSS</button>
                <button class="@(brand==BrandDemo.Midnight ? "selected" : "")" aria-pressed="@(brand==BrandDemo.Midnight ? "true" : "false")" @onclick="()=>brand=BrandDemo.Midnight">Midnight</button>
            </div>
            <div class="segmented axis-choice" role="group" aria-label="Axis type">
                <button class="@(axisDemo==AxisDemo.Numeric ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Numeric ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Numeric">Numeric axes</button>
                @if(DemoData.TimeCapable(selected)) { <button class="@(axisDemo==AxisDemo.Time ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Time ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Time">Time X</button> }
                @if(DemoData.LogCapable(selected)) { <button class="@(axisDemo==AxisDemo.Log ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Log ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Log">Log Y</button> }
                @if(DemoData.DurationCapable(selected))
                {
                    <button class="@(axisDemo==AxisDemo.PowerCurve ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.PowerCurve ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.PowerCurve">Log duration X</button>
                    <button class="@(axisDemo==AxisDemo.Pace ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Pace ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Pace">Reversed pace Y</button>
                }
                @if(DemoData.ZoneCapable(selected)) { <button class="@(axisDemo==AxisDemo.Zones ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Zones ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Zones">Heart-rate zones</button> }
                @if(DemoData.PerformanceCapable(selected)) { <button class="@(axisDemo==AxisDemo.Performance ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Performance ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Performance">Fitness and fatigue</button> }
                @if(DemoData.TargetCapable(selected)) { <button class="@(axisDemo==AxisDemo.Target ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Target ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Target">Load against target</button> }
                @if(DemoData.StreamCapable(selected)) { <button class="@(axisDemo==AxisDemo.Stream ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Stream ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Stream">Activity stream</button> }
                @if(DemoData.FitsCapable(selected)) { <button class="@(axisDemo==AxisDemo.Fits ? "selected" : "")" aria-pressed="@(axisDemo==AxisDemo.Fits ? "true" : "false")" @onclick="()=>axisDemo=AxisDemo.Fits">Curved fits</button> }
            </div>
            <div class="chart-card"><div class="card-meta"><span><i></i> LIVE COMPONENT <span class="divider">/</span> @Name(selected)</span><button @onclick="()=>revision++">↻ Refresh sample</button></div>
                @Branded(@<LumenChart @key="(selected,axisDemo)" Spec="Current" PointSelected="OnPoint" FitWidth="true"/>)
            </div>
            <div class="under-chart"><span>↳ @Hint</span><span>@(selection ?? "Select a point to inspect its value")</span></div>
        </section>
        <section class="lower-grid">
            <article class="small-card"><div class="eyebrow">DESIGNED TO COMMUNICATE</div><h3>Good defaults.<br/>Honest comparisons.</h3><p>Zero baselines for bars. Explicit gaps for missing data. Readable labels and an underlying data table.</p><div class="mini-tags"><span>No charting JS dependencies</span><span>Typed data binding</span></div></article>
            <article class="small-card accent"><div class="eyebrow">TAKE YOUR WORK WITH YOU</div><h3>Ready for the<br/>next conversation.</h3><p>Export crisp SVG graphics for reports or the original observations as CSV. Your data stays yours.</p><a href="#integration">Explore the rendering API ↗</a></article>
        </section>
        <section id="network"><div class="section-heading"><div><div class="eyebrow">BEYOND THE AXES</div><h2>See how everything connects.</h2></div><div class="segmented"><button class="@(layout==GraphLayout.Layered?"selected":"")" @onclick="()=>SetLayout(GraphLayout.Layered)">Layered</button><button class="@(layout==GraphLayout.Circular?"selected":"")" @onclick="()=>SetLayout(GraphLayout.Circular)">Circular</button></div></div><div class="chart-card">@Branded(@<LumenGraph Spec="Graph" NodeSelected="OnNode" FitWidth="true"/>)</div><p class="quiet">@(node ?? "Drag a node to move it, or focus one and press Enter to select it and the arrow keys to nudge it. Layered layouts order each level to reduce edge crossings and require an acyclic graph.")</p></section>
        <section id="integration" class="integration"><div><div class="eyebrow">SMALL API. REAL POSSIBILITIES.</div><h2>From C# to clarity.</h2><p>Share one chart specification between your Blazor interface, your reports, and your HTTP API.</p><a href="/api/charts/types" target="_blank">View supported API chart types ↗</a></div><pre><code>@Snippet</code></pre></section>
        <footer><span class="brand">lumen.</span><span>Charts that help you see.</span><span>Preview 0.1 · Built with Blazor</span></footer>
    </main>
</div>
@code {
    private ChartKind selected=ChartKind.Area;
    private AxisDemo axisDemo=AxisDemo.Numeric;
    // The theme and brand live in the circuit, so the Sports & performance page opens in the ones picked here, and back.
    private BrandDemo brand{get=>Look.Brand;set=>Look.Brand=value;}
    private bool dark{get=>Look.Dark;set=>Look.Dark=value;}
    // Page CSS reads this page's own custom properties, so it follows the dark-mode switch by itself;
    // Harbour and Midnight are fixed in C#, and the Lumen brand is the library default driven by the theme.
    private RenderFragment Branded(RenderFragment content) => brand switch
    {
        BrandDemo.Midnight => @<CascadingValue Value="ChartStyle.Midnight">@content</CascadingValue>,
        BrandDemo.PageCss => @<LumenBrand Series="--brand-1, --brand-2, --brand-3, --brand-4" Background="--surface" Text="--text" Muted="--muted" Grid="--line">@content</LumenBrand>,
        BrandDemo.Harbour => @<CascadingValue Value="DemoData.Harbour">@content</CascadingValue>,
        _ => content
    };
    private GraphLayout layout=GraphLayout.Layered;
    private int revision;private string? selection;private string? node;private GraphSpec? graphCache;
    private GraphSpec Graph=>graphCache ??= DemoData.Graph(layout,Theme);
    private void SetLayout(GraphLayout value){layout=value;graphCache=null;node=null;}
    private void ToggleTheme(){dark=!dark;graphCache=null;}
    private void OnNode(string id)=>node=$"Selected node \"{id}\" — drag it, or press Reset layout to restore the computed position.";
    private ChartTheme Theme=>dark?ChartTheme.Dark:ChartTheme.Light;
    // Bar ends belong to a brand: the Lumen brand rounds the weekly load into capsules and leaves the other columns square.
    private ChartSpec Current
    {
        get
        {
            var spec=DemoData.Create(selected,Theme,revision,axisDemo);
            return brand==BrandDemo.Lumen&&axisDemo==AxisDemo.Target?spec with{Style=ChartSvg.ResolveStyle(spec) with{BarRadius=9999}}:spec;
        }
    }
    private void Select(ChartKind kind)
    {
        selected=kind;selection=null;
        if(axisDemo==AxisDemo.Time&&!DemoData.TimeCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo==AxisDemo.Log&&!DemoData.LogCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo is AxisDemo.PowerCurve or AxisDemo.Pace&&!DemoData.DurationCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo==AxisDemo.Zones&&!DemoData.ZoneCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo==AxisDemo.Performance&&!DemoData.PerformanceCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo==AxisDemo.Target&&!DemoData.TargetCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo==AxisDemo.Stream&&!DemoData.StreamCapable(kind))axisDemo=AxisDemo.Numeric;
        if(axisDemo==AxisDemo.Fits&&!DemoData.FitsCapable(kind))axisDemo=AxisDemo.Numeric;
    }
    private void OnPoint(PointSelection p)=>selection=$"Selected series {p.SeriesIndex+1}, observation {p.PointIndex+1}";
    private static string Name(ChartKind kind)=>kind switch {ChartKind.StackedColumn=>"Stacked",ChartKind.Candlestick=>"Candles",ChartKind.Ohlc=>"OHLC",ChartKind.Ring=>"Rings",_=>kind.ToString()};
    private string Hint=>axisDemo switch {AxisDemo.PowerCurve=>"Best average power for each duration, on a log duration axis. The dashed line is the critical-power fit.",AxisDemo.Pace=>"Pace is seconds per kilometre read as m:ss, on a reversed axis: higher is faster.",AxisDemo.Zones=>selected==ChartKind.Bar?"Each bar is one zone, drawn in its zone's colour; the time reads as m:ss.":"The line changes colour exactly where it crosses a zone bound, over the zone bands; each point names its zone.",AxisDemo.Performance=>"Fitness and fatigue are lines over each day's training stress, and form is an area on the right-hand axis. The last two weeks are planned, so the lines are dashed from there, and the ring marks the fitness to arrive with.",AxisDemo.Target=>"The range is drawn first and each week's load in front of it; a week standing above the range is a jump in load. The Lumen brand draws the weeks as capsules.",AxisDemo.Stream=>"Heart rate, pace and climb stand in three panes over one elapsed-time axis. The heart-rate line is coloured continuously by its value over the zone bands, the climb is a smooth faded area, and the markers are hidden, though every reading can still be focused. Zooming or panning moves the panes together, and hiding a series closes its pane.",AxisDemo.Fits=>"Throughput climbs with the load until contention takes it back, so its dashed fit is quadratic; latency is multiplied by a steady factor for every user added, so its fit is exponential, read on the right-hand axis. Each is drawn only across the users tested, and carries its R squared in its accessible name and in an exported SVG's tooltip.",_=>selected switch {ChartKind.Area or ChartKind.Line=>"Follow change over time. Missing observations remain gaps.",ChartKind.Bar or ChartKind.Column or ChartKind.StackedColumn=>"Compare magnitude with a consistent zero baseline.",ChartKind.Donut=>"Compare parts of a whole. Values must be nonnegative.",ChartKind.Scatter=>"The dashed line is a least-squares fit; hover it for the direction and R squared.",ChartKind.Bubble=>"Bubble area represents the third measure.",ChartKind.Candlestick=>"Each candle spans open to close; the wick shows the day's range. The line is the five-day average, and the volume traded stands in a pane beneath.",ChartKind.Ohlc=>"The line is the day's range; the left tick is the open and the right tick the close. The five-day average runs over the bars, with volume beneath.",ChartKind.Band=>"The shaded interval carries the uncertainty around the projection.",ChartKind.Histogram=>"Bars count observations per bin; both series share the bins, so bars side by side cover the same range.",ChartKind.Box=>"Box shows the quartiles; circles lie beyond 1.5 interquartile ranges. Asia is a supplied summary.",ChartKind.Violin=>"The outline is a kernel density estimate over the observed range; the bar is the quartiles.",ChartKind.Gauge=>"The track is tinted by the recovery tiers and the score takes its tier's colour; the tick is the seven-day average.",ChartKind.Ring=>"Each ring is its value over its goal, clockwise from twelve o'clock. Exercise is past its goal, so it runs on over itself, its leading end shadowed where it overlaps.",ChartKind.Timeline=>"Each sleep stage is a lane and each stretch of it a span, joined to the next where the stage changes. The legend totals each stage and its share of the night; zoom to read the small hours.",ChartKind.Range=>"Each bar runs from the day's lowest heart rate to its highest, and the dot is its average. Nothing is drawn from zero, so the bars float where the day was.",ChartKind.Calendar=>"Each column is a week and each row a weekday, every day in the tier of its training stress; grey days are rest days. Today is outlined. Focus a day to read its stress.",ChartKind.Strip=>"Each zone is as long as its share of the week's time, parted from the next by a gap; the key under the bar gives every zone's whole percentage, adding up to exactly 100. Focus a zone to read its time.",ChartKind.Blocks=>"Each step of the workout is a block as long as it lasts and as high as its target, in its Coggan power level, and the ride's power runs over the plan. Focus a block to read its step, its span and its target; zoom in to read one interval.",_=>"Hover or focus a mark for details. Toggle series in the legend."}};
    private const string Snippet="@using Lumen.Charts\n@using Lumen.Charts.Blazor\n\n<LumenChart Spec=\"chart\" />\n\n@code {\n    ChartSpec chart = new() {\n        Title = \"A clearer view\",\n        Kind = ChartKind.Line,\n        Series = [new(\"Revenue\", [\n            new(1, 24), new(2, 38), new(3, 52)\n        ])]\n    };\n}";
}
