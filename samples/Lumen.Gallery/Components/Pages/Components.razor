@page "/components"
@inject GalleryLook Look
<PageTitle>Beyond charts — Lumen</PageTitle>
<div class="app sports @(Look.Dark ? "dark" : "")">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-icon">◒</span> lumen<span class="brand-dot">.</span></a>
        <div class="workspace">VISUALIZATION LIBRARY <span>0.1</span></div>
        <a class="nav-item" href="/#playground"><span>▦</span> Chart explorer <b>23</b></a>
        <a class="nav-item" href="/#network"><span>⌘</span> Network graphs <b>2</b></a>
        <a class="nav-item" href="/#integration"><span>⌁</span> Developer API</a>
        <a class="nav-item" href="sports"><span>∿</span> Sports &amp; performance <b>33</b></a>
        <a class="nav-item active" href="components" aria-current="page"><span>▤</span> Beyond charts <b>4</b></a>
        <div class="nav-label">ON THIS PAGE</div>
        <a class="purpose" href="components#season">Season at a glance<span>↓</span></a>
        <a class="purpose" href="components#rounds">Round by round<span>↓</span></a>
        <a class="purpose" href="components#results">Results<span>↓</span></a>
        <a class="purpose" href="components#log">Training log<span>↓</span></a>
        <div class="sidebar-bottom"><span class="live-dot"></span> Invented season<p>One rider, twelve rounds.</p><a href="/#integration">Start building →</a></div>
    </aside>
    <main>
        <header class="topbar"><div>Library <span>/</span> <strong>Beyond charts</strong></div><div class="top-actions"><span class="version">Invented data</span><button @onclick="ToggleTheme" aria-label="Toggle color theme">@(Look.Dark ? "☀ Light mode" : "☾ Dark mode")</button></div></header>
        <section class="sports-intro">
            <div class="eyebrow"><span></span> STAT TILES</div>
            <h1>Headline numbers. <em>Said in words.</em></h1>
            <p>Not every number wants an axis. <code>LumenStats</code> writes a label, a value and its change as plain HTML: the arrow, the colour and the meter are each said in words as well, so nothing rests on colour alone. The same markup comes from a prerender, a circuit and the <code>stats/html</code> endpoint.</p>
            <div class="segmented" role="group" aria-label="Chart brand">
                @foreach (var (choice, name) in Brands)
                { <button class="@(Look.Brand == choice ? "selected" : "")" aria-pressed="@(Look.Brand == choice ? "true" : "false")" @onclick="() => SetBrand(choice)">@name</button> }
            </div>
        </section>
        <section id="season" class="sports-section">
            <div class="chart-card comp-card">@Branded(@<LumenStats Spec="DemoData.SeasonTiles(Style)"/>)</div>
        </section>
        <section id="rounds" class="sports-section">
            <div class="chart-card comp-card">@Branded(@<LumenStats Spec="DemoData.RoundStrip(Style)"/>)</div>
        </section>
        <section class="sports-intro">
            <div class="eyebrow"><span></span> DATA TABLE</div>
            <h1>Rows to read. <em>Columns to sort.</em></h1>
            <p><code>LumenTable</code> writes a real HTML table: press a header to sort, page through long lists, and scroll sideways on a phone while the header row and the first column stay in view. Every arrow, bar and trend line is also written in words, and <code>ShowExport</code> adds a CSV of the rows.</p>
        </section>
        <section id="results" class="sports-section">
            <div class="chart-card comp-card comp-table">@Branded(@<LumenTable Spec="DemoData.ResultsTable(Style)" ShowExport="true"/>)</div>
        </section>
        <section id="log" class="sports-section">
            <div class="chart-card comp-card comp-table">@Branded(@<LumenTable Spec="DemoData.TrainingLog(Style)"/>)</div>
        </section>
        <footer><span class="brand">lumen.</span><span>Charts that help you see.</span><span>Invented data · Built with Blazor</span></footer>
    </main>
</div>
@code {
    private static readonly (BrandDemo Brand, string Name)[] Brands =
        [(BrandDemo.Lumen, "Lumen brand"), (BrandDemo.Harbour, "Harbour (C#)"), (BrandDemo.PageCss, "Page CSS"), (BrandDemo.Midnight, "Midnight")];
    // The Lumen brand cascades no style, so the tiles ask for the theme's own, which is the card's colour; the other brands cascade theirs.
    private ChartStyle? Style => Look.Brand == BrandDemo.Lumen ? (Look.Dark ? ChartStyle.Dark : ChartStyle.Light) : null;
    private RenderFragment Branded(RenderFragment content) => Look.Brand switch
    {
        BrandDemo.Midnight => @<CascadingValue Value="ChartStyle.Midnight">@content</CascadingValue>,
        BrandDemo.PageCss => @<LumenBrand Series="--brand-1, --brand-2, --brand-3, --brand-4" Background="--surface" Text="--text" Muted="--muted" Grid="--line">@content</LumenBrand>,
        BrandDemo.Harbour => @<CascadingValue Value="DemoData.Harbour">@content</CascadingValue>,
        _ => content
    };
    private void ToggleTheme() => Look.Dark = !Look.Dark;
    private void SetBrand(BrandDemo brand) => Look.Brand = brand;
}
