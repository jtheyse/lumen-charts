<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles every recipe in the Claude Code skill's references together, as written, and renders each chart. check.py
       writes the program into obj/Recipes.g.cs; kept out of the solution. -->
  <!-- CS8321: a recipe may show a helper the app calls elsewhere, such as the server-side bin rule, which this program never calls. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><IsPackable>false</IsPackable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>$(NoWarn);CS8321</NoWarn><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup><Compile Include="obj/Recipes.g.cs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/Lumen.Charts/Lumen.Charts.csproj" /></ItemGroup>
</Project>
