@implements IAsyncDisposable
@inject IJSRuntime JS
@if(Spec.Sparkline)
{
    @* A sparkline is its drawing alone, read through its marks' tooltips: no legend, toolbar, zoom or data table, and no scrolling region. *@
    <div class="@(FitWidth ? "lumen-chart lumen-spark lumen-fit" : "lumen-chart lumen-spark")" @ref="root"><div class="lumen-viewport">@((MarkupString)svg)</div></div>
}
else
{
<div class="@(FitWidth ? "lumen-chart lumen-fit" : "lumen-chart")" @ref="root">
    <div class="lumen-viewport" tabindex="0" role="region" aria-label="Scrollable chart">@((MarkupString)svg)</div>
    <div class="lumen-legend" aria-label="Chart series">
        @for(var i=0;i<Spec.Series.Count;i++)
        {
            var index=i;
            <button type="button" aria-pressed="@(!hidden.Contains(i) ? "true" : "false")" @onclick="()=>Toggle(index)">
                @* A refined key is the chart's own legend key, shaped like the series' mark. *@
                @if(Style.Finish==ChartFinish.Classic){<span style="background:@ChartSvg.SeriesColor(Spec.Series[i],i,Style)"></span>}else{@((MarkupString)ChartSvg.LegendKey(Spec with{Style=Style},i))}@ChartSvg.LegendLabel(Spec,i)
            </button>
        }
    </div>
    <div class="lumen-tools">
        @if(CanZoom)
        {
            <button type="button" @onclick="()=>Zoom(.5)" aria-label="Zoom in">+</button>
            <button type="button" @onclick="()=>Zoom(2)" aria-label="Zoom out">−</button>
            <button type="button" @onclick="()=>Pan(-1)" aria-label="Pan left">←</button>
            <button type="button" @onclick="()=>Pan(1)" aria-label="Pan right">→</button>
            <button type="button" @onclick="ResetView">Reset view</button>
        }
        <button type="button" @onclick='()=>Download("svg")'>Export SVG</button>
        <button type="button" @onclick='()=>Download("png")'>Export PNG</button>
        <button type="button" @onclick='()=>Download("csv")'>Export CSV</button>
        <button type="button" @onclick="()=>showData=!showData" aria-expanded="@(showData ? "true" : "false")">@(showData ? "Hide data" : "View data")</button>
        <span class="lumen-status" role="status">@status</span>
    </div>
    @if(showData)
    {
        <div class="lumen-table"><table><caption>@Spec.Title — original data (@Spec.Series.Sum(s=>s.Points.Count) observations)</caption>
        <thead><tr><th scope="col">Series</th><th scope="col">X / Category</th><th scope="col">Value</th></tr></thead><tbody>
        @foreach(var series in Spec.Series)
        {
            @foreach(var point in series.Points.Take(500))
            { <tr><td>@series.Name</td><td>@(point.Label ?? xAxis.Format(point.X))</td><td>@Value(series,point)</td></tr> }
        }
        </tbody></table><p>Table shows up to 500 observations per series. CSV contains all original observations.</p></div>
    }
</div>
}
@code {
    /// <summary>The chart to draw. Set a new spec to update it. Whenever it is set, the zoom resets and the series the reader
    /// has hidden stay hidden.</summary>
    [Parameter, EditorRequired] public ChartSpec Spec { get; set; } = new();
    /// <summary>Raised when a mark is clicked, or chosen with Enter or Space, with the series and point it came from in the
    /// original <see cref="Spec"/>, whatever is hidden or zoomed. Needs an interactive render mode.</summary>
    [Parameter] public EventCallback<PointSelection> PointSelected { get; set; }
    /// <summary>
    /// Draws the chart at the width its container gives it instead of at <see cref="ChartSpec.Width"/>, so that its text stays
    /// at its own size on a phone or in a narrow card rather than being scaled down, and lifts the stylesheet's 640-pixel
    /// minimum for this chart alone. The width is measured in the browser once the component is interactive, and again
    /// whenever the container settles at a new width. Until then, and in static rendering, the chart is drawn at
    /// <see cref="ChartSpec.Width"/> and scaled to fit. It is never drawn narrower than 320 pixels, the narrowest width a chart
    /// accepts, or 60 for a sparkline, and the SVG and PNG exports take the width it is drawn at.
    /// </summary>
    [Parameter] public bool FitWidth { get; set; }
    /// <summary>A host-wide style, usually cascaded by <see cref="LumenBrand"/>. A style on the spec itself wins.</summary>
    [CascadingParameter] public ChartStyle? CascadingStyle { get; set; }
    private ChartStyle Style => Spec.Style ?? CascadingStyle ?? ChartSvg.ResolveStyle(Spec);
    private readonly HashSet<int> hidden=[];
    private string svg="",status="";
    private bool showData;
    private ElementReference root;
    private IJSObjectReference? module;
    private DotNetObjectReference<LumenChart>? reference;
    private int[] visible=[];
    private Axis xAxis;
    private double? viewMin, viewMax;
    // The width the container last reported while FitWidth is on, and whether the script is measuring it. A chart accepts
    // widths from 320 to 4096 pixels, and a sparkline from 60.
    private int? fitted;
    private bool fitting;
    private const int Widest=4096;
    private int Narrowest => Spec.Sparkline ? 60 : 320;
    private int Width => FitWidth && fitted is { } width ? width : Spec.Width;
    private bool CanZoom => Spec.Kind is ChartKind.Line or ChartKind.Area or ChartKind.Scatter or ChartKind.Bubble or ChartKind.Candlestick or ChartKind.Ohlc or ChartKind.Band or ChartKind.Range or ChartKind.Timeline or ChartKind.Blocks;
    private string Value(ChartSeries series,ChartPoint point)
    {
        var y=Measure(series);
        return (series.Kind ?? Spec.Kind) switch
        {
            ChartKind.Candlestick or ChartKind.Ohlc=>$"O {y.Format(point.Open ?? 0)} · H {y.Format(point.High ?? 0)} · L {y.Format(point.Low ?? 0)} · C {y.Format(point.Close ?? 0)}",
            ChartKind.Ring when point.Y.HasValue=>$"{y.Format(point.Y.Value)} of {y.Format(series.Goal ?? 100)}",
            // A timeline span reads its start in the X column, and how long it runs to its end here.
            ChartKind.Timeline when point.XEnd is {} end=>$"to {xAxis.Format(end)}",
            // A block reads its height and the span it covers.
            ChartKind.Blocks when point.XEnd is {} end&&point.Y.HasValue=>$"{y.Format(point.Y.Value)}{point.ValueNote} from {xAxis.Format(point.X)} to {xAxis.Format(end)}",
            ChartKind.Range when point.Y is null&&point.Low.HasValue&&point.High.HasValue=>$"{y.Format(point.Low.Value)} to {y.Format(point.High.Value)}",
            _ when point.Y.HasValue&&point.Low.HasValue&&point.High.HasValue=>$"{y.Format(point.Y.Value)}{point.ValueNote} ({y.Format(point.Low.Value)} to {y.Format(point.High.Value)})",
            // A value's note follows it, as it does in the mark's name.
            _=>point.Y.HasValue?y.Format(point.Y.Value)+point.ValueNote:"Missing"
        };
    }
    // How a value reads depends only on the axis kind and format, so the bounds here are nominal. A series in a pane below
    // the main plot reads through that pane's axes.
    private Axis Measure(ChartSeries series)
    {
        var pane=series.Pane>0&&series.Pane<=Spec.Panes.Count?Spec.Panes[series.Pane-1]:null;
        return series.Secondary ? new(pane?.Y2Axis ?? Spec.Y2Axis,1,10){ValueFormat=pane?.Y2Format ?? Spec.Y2Format} : new(pane?.YAxis ?? Spec.YAxis,1,10){ValueFormat=pane?.YFormat ?? Spec.YFormat};
    }
    // A timeline's spans reach to their ends.
    private Axis FullRange => Axis.Create(Spec.XAxis,Spec.Series.SelectMany(s=>s.Points).SelectMany(p=>p.XEnd is {} end?new[]{p.X,end}:new[]{p.X}), min:Spec.XMin, max:Spec.XMax, zone:TimeAxis.Zone(Spec.TimeZone),
        weekends:Spec.SkipWeekends, skips:Spec.TimeSkips.Count>0?Spec.TimeSkips:null) with {ValueFormat=Spec.XFormat};
    // The view is tracked as a fraction of the full axis so log and time domains zoom in their own space.
    private (double Min,double Max) View { get { var full=FullRange;return (viewMin.HasValue?full.Map(viewMin.Value,0,1):0,viewMax.HasValue?full.Map(viewMax.Value,0,1):1); } }
    private void Zoom(double factor)
    {
        var (min,max)=View;var span=Math.Clamp((max-min)*factor,.01,1);
        SetView((min+max)/2-span/2,span);
    }
    private void Pan(int direction)
    {
        var (min,max)=View;SetView(min+direction*(max-min)*.25,max-min);
    }
    private void SetView(double start,double span)
    {
        var full=FullRange;var from=Math.Clamp(start,0,1-span);
        viewMin=full.Invert(from,0,1);viewMax=full.Invert(from+span,0,1);Render();
    }
    private void ResetView() { viewMin=null;viewMax=null;Render(); }
    protected override void OnParametersSet() { hidden.RemoveWhere(i=>i>=Spec.Series.Count);viewMin=null;viewMax=null;Render(); }
    private ChartSpec VisibleSpec()
    {
        var spec=Spec with { Width=Width, Style=Style, XMin=CanZoom ? viewMin ?? Spec.XMin : Spec.XMin, XMax=CanZoom ? viewMax ?? Spec.XMax : Spec.XMax, Series=visible.Select(i=>Spec.Series[i] with {Color=ChartSvg.SeriesColor(Spec.Series[i],i,Style),Points=hidden.Contains(i)?[]:Spec.Series[i].Points}).ToArray() };
        if(Spec.Panes.Count==0||Spec.Series.Any(s=>s.Pane<0||s.Pane>Spec.Panes.Count))return spec;
        // A pane its hidden series leave empty closes and the panes under it move up, the first one left taking the main
        // plot's place and settings. Hidden candles whose pane closes move to the main plot.
        var used=visible.Where(i=>!hidden.Contains(i)).Select(i=>Spec.Series[i].Pane).Distinct().Order().DefaultIfEmpty().ToArray();
        spec=spec with { Panes=used.Skip(1).Select(p=>Spec.Panes[p-1]).ToArray(), Series=spec.Series.Select(s=>s with {Pane=Math.Max(0,Array.IndexOf(used,s.Pane))}).ToArray() };
        if(used[0]==0)return spec;
        var main=Spec.Panes[used[0]-1];
        return spec with { YLabel=main.Label, YAxis=main.YAxis, YMin=main.YMin, YMax=main.YMax, YMinSpan=main.YMinSpan, YFormat=main.YFormat, YReversed=main.YReversed, YZones=main.YZones,
            Y2Label=main.Y2Label, Y2Axis=main.Y2Axis, Y2Min=main.Y2Min, Y2Max=main.Y2Max, Y2Format=main.Y2Format, Y2Reversed=main.Y2Reversed, Annotations=Spec.Annotations.Where(a=>a?.Axis!=AnnotationAxis.Y).ToArray() };
    }
    // Hidden candles stay without their points, because a candlestick or OHLC chart draws its other series beside them; and a
    // hidden state keeps its lane, so the timeline's lanes stand where they did.
    private bool Candles(int index) => Spec.Kind is ChartKind.Candlestick or ChartKind.Ohlc && Spec.Series[index].Kind is null || Spec.Kind == ChartKind.Timeline;
    // The component draws its own tooltips, so marks render without the native SVG title.
    private void Render() { xAxis=FullRange;visible=Enumerable.Range(0,Spec.Series.Count).Where(i=>!hidden.Contains(i)||Candles(i)).ToArray();svg=ChartSvg.Render(VisibleSpec(), includeLegend:false, includeTitles:false); }
    private void Toggle(int index) { if(!hidden.Add(index))hidden.Remove(index);Render(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender) { module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/Lumen.Charts.Blazor/lumen.js");reference=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("attach",root,reference); }
        // The script measures the chart's box only while the chart is asked to fit it.
        if(module is not null&&FitWidth!=fitting)
        {
            fitting=FitWidth;
            if(!fitting)fitted=null;
            await module.InvokeVoidAsync(fitting?"fit":"unfit",root,reference);
        }
    }
    /// <summary>Called by the component's script, while <see cref="FitWidth"/> is on, with the width in whole pixels that the
    /// chart's container gives it. The chart is redrawn at that width, keeping its zoom and hidden series.</summary>
    [JSInvokable] public Task Fit(int width) => InvokeAsync(()=>
    {
        var next=Math.Clamp(width,Narrowest,Widest);
        if(!FitWidth||next==fitted)return;
        fitted=next;Render();StateHasChanged();
    });
    /// <summary>Called by the component's script when a mark is selected, with the index of its series among those drawn
    /// and its point index. It reports the point in the status line and raises <see cref="PointSelected"/>.</summary>
    [JSInvokable] public async Task SelectPoint(int series,int point)
    {
        if(series<0||series>=visible.Length)return;
        var index=visible[series];if(point<0||point>=Spec.Series[index].Points.Count)return;
        var p=Spec.Series[index].Points[point];
        // A gauge's or a ring's one point reads as its legend does, with its unit and a ring's goal.
        // A span reads from its start to its end, a block its label, its span and its height, and a range bar from its low to its
        // high and its typical value.
        status=Spec.Kind is ChartKind.Gauge or ChartKind.Ring ? ChartSvg.LegendLabel(Spec,index)
            : Spec.Kind==ChartKind.Calendar ? Day(index,p)
            : p.XEnd is {} end&&(Spec.Series[index].Kind ?? Spec.Kind)==ChartKind.Blocks&&p.Y is {} height ? $"{Spec.Series[index].Name}: {(p.Label is null ? "" : p.Label+", ")}{xAxis.Format(p.X)} to {xAxis.Format(end)} = {Measure(Spec.Series[index]).Format(height)}{p.ValueNote}"
            : p.XEnd is {} finish ? $"{Spec.Series[index].Name}: {xAxis.Format(p.X)} to {xAxis.Format(finish)}"
            : (Spec.Series[index].Kind ?? Spec.Kind)==ChartKind.Range&&p.Low is {} low&&p.High is {} high ? $"{Spec.Series[index].Name}: {p.Label ?? xAxis.Format(p.X)} = {Measure(Spec.Series[index]).Format(low)} to {Measure(Spec.Series[index]).Format(high)}{(p.Y is {} typical ? $", average {Measure(Spec.Series[index]).Format(typical)}" : "")}"
            : $"{Spec.Series[index].Name}: {p.Label ?? xAxis.Format(p.X)} = {(p.Y is {} y ? Measure(Spec.Series[index]).Format(y)+p.ValueNote : "missing")}";
        await PointSelected.InvokeAsync(new(index,point));await InvokeAsync(StateHasChanged);
    }
    // A calendar's mark is a day, which reports its first point: it reads the day, in the chart's zone, and the total of every
    // point on it.
    private string Day(int index,ChartPoint point)
    {
        var zone=TimeAxis.Zone(Spec.TimeZone);var series=Spec.Series[index];
        DateOnly On(double x){var utc=TimeAxis.Moment(x).UtcDateTime;return DateOnly.FromDateTime(zone is null?utc:TimeZoneInfo.ConvertTimeFromUtc(utc,zone));}
        var day=On(point.X);
        return $"{series.Name}: {day.ToString("ddd d MMM yyyy",System.Globalization.CultureInfo.InvariantCulture)} = {Measure(series).Format(series.Points.Where(p=>On(p.X)==day).Sum(p=>p.Y ?? 0))}";
    }
    private async Task Download(string format)
    {
        if(module is null)return;
        try
        {
            if(format=="png")await module.InvokeVoidAsync("png",ChartSvg.Render(VisibleSpec()),"chart.png",2);
            else await module.InvokeVoidAsync("download",format=="svg"?ChartSvg.Render(VisibleSpec()):ChartExport.Csv(Spec),$"chart.{format}",format=="svg"?"image/svg+xml":"text/csv");
            status=$"Exported chart.{format}";
        }
        catch(JSException error) { status=$"Export failed: {error.Message}"; }
    }
    /// <summary>Removes the chart's tooltip and event handlers from the page and stops measuring its box.</summary>
    public async ValueTask DisposeAsync()
    {
        try { if(module is not null) { await module.InvokeVoidAsync("detach",root);await module.DisposeAsync(); } }
        catch(JSDisconnectedException) { }
        finally { reference?.Dispose(); }
    }
}
